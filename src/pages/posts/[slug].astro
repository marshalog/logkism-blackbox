---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogNavbar from '../../components/BlogNavbar.astro';
import BlogFooter from '../../components/BlogFooter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { BASE } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const postsCollection = await getCollection('posts');
  return postsCollection.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <BlogNavbar current="blog" />

  <main id="main-content" class="post-layout">
    {headings.length > 0 && (
      <aside class="post-toc-sidebar">
        <div class="post-toc-container">
          <div class="post-toc__trigger" title="Table of Contents">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <div class="post-toc__dropdown panel brackets">
            <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
            <h4 class="f-mono accent" style="font-size: 0.8rem; margin-bottom: 1rem; border-bottom: 1px dashed var(--line); padding-bottom: 0.5rem;">TABLE OF CONTENTS</h4>
            <ul class="post-toc__list">
              {headings.map((h) => (
                <li class={`toc-level-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    )}

    <article class="wrap post-article">
      <!-- Back button -->
      <div class="post-back" data-reveal="0.1">
        <a href={`${BASE}`} class="link-slash f-mono" data-cursor="BACK">
          ← BACK TO ARTICLES
        </a>
      </div>

      <!-- Article Header -->
      <header class="post-header panel brackets" data-reveal="0.2">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <div class="post-header__meta f-mono">
          <span>DATE: {post.data.date.toISOString().split('T')[0]}</span>
          <span class="meta-sep">·</span>
          <span>EST. READING: {post.data.readTime}</span>
        </div>

        <h1 class="post-title f-display" data-split="chars">
          {post.data.title}
        </h1>

        <div class="post-tags f-mono">
          {post.data.tags.map((tag) => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
      </header>

      <div class="post-body panel brackets" data-reveal="0.3">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <div class="markdown-render">
          <Content />
        </div>
      </div>

      <!-- Post End Navigation -->
      <div class="post-end panel" data-reveal="0.4">
        <div class="post-end__inner">
          <div>
            <span class="micro accent">END OF ARTICLE</span>
            <p class="f-mono text-muted">Wrote by SOOLOGNZz</p>
          </div>
          <a href={`${BASE}`} class="btn btn--primary" data-cursor="INDEX">
            <span class="btn__tab"></span>
            <span class="btn__fill"></span>
            <span class="btn__label">OTHER ARTICLES ↗</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <BlogFooter />
</BaseLayout>

<style>
  .post-layout {
    padding-top: calc(var(--hud-h) + 2rem);
    padding-bottom: 5rem;
  }
  .post-article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-back {
    margin-bottom: 0.5rem;
  }
  .post-header {
    padding: clamp(2rem, 5vw, 3.5rem);
    background: rgba(13, 13, 17, 0.7);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .post-header__meta {
    font-size: var(--fs-xs);
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .post-title {
    font-size: clamp(1.8rem, 3.8vw, 3.2rem);
    line-height: 1.1;
    color: var(--fg);
  }
  .post-tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tag-badge {
    font-size: 11px;
    color: var(--accent-hi);
    padding: 3px 8px;
    border: 1px solid var(--line-accent);
    background: rgba(193, 18, 31, 0.08);
  }

  .post-body {
    padding: clamp(2rem, 5vw, 3.5rem);
    background: rgba(13, 13, 17, 0.6);
    position: relative;
  }

  /* Table of Contents Sidebar */
  .post-toc-sidebar {
    position: fixed;
    top: 25%;
    left: 2rem;
    z-index: 100;
  }

  @media (max-width: 1300px) {
    .post-toc-sidebar {
      display: none; /* Hide on smaller screens where there's no space on the left */
    }
  }

  .post-toc-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .post-toc__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(13, 13, 17, 0.9);
    border: 1px solid var(--line-accent);
    border-radius: 50%;
    color: var(--accent);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  }

  .post-toc-container:hover .post-toc__trigger {
    background: rgba(193, 18, 31, 0.2);
    color: var(--accent-hi);
    transform: rotate(90deg);
  }

  .post-toc__dropdown {
    position: absolute;
    top: 0;
    left: 60px; /* Right next to the button */
    width: max-content;
    max-width: 350px;
    background: rgba(13, 13, 17, 0.95);
    backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 1.5rem;
    pointer-events: none;
  }

  .post-toc-container:hover .post-toc__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .post-toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.85rem;
  }

  .post-toc__list li {
    margin-bottom: 0.5rem;
  }
  
  .post-toc__list li:last-child {
    margin-bottom: 0;
  }

  .toc-level-1 { padding-left: 0; font-weight: 600; }
  .toc-level-2 { padding-left: 0.5rem; }
  .toc-level-3 { padding-left: 1.5rem; }
  .toc-level-4 { padding-left: 2.5rem; }

  .post-toc__list a {
    color: var(--muted);
    text-decoration: none;
    display: block;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .post-toc__list a:hover {
    color: var(--accent-hi);
  }

  .post-end {
    padding: 2rem;
    background: rgba(22, 22, 28, 0.5);
  }
  .post-end__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
