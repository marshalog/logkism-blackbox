---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogNavbar from '../../components/BlogNavbar.astro';
import BlogFooter from '../../components/BlogFooter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { BASE } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const postsCollection = await getCollection('posts');
  return postsCollection.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <BlogNavbar current="blog" />

  <main id="main-content" class="post-layout post-two-column-wrap">
    {headings.length > 0 && (
      <aside class="post-toc-sidebar">
        <div class="toc-card">
          <div class="toc-title-bar">
            <svg class="toc-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            Table of contents
          </div>
          <div class="post-toc__list-wrapper">
            <ul class="post-toc__list">
              {headings.map((h) => (
                <li class={`toc-level-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    )}

    <article class="wrap post-article">
      <!-- Back button -->
      <div class="post-back" data-reveal="0.1">
        <a href={`${BASE}`} class="link-slash f-mono" data-cursor="BACK">
          ← BACK TO ARTICLES
        </a>
      </div>

      <!-- Article Header -->
      <header class="post-header panel brackets" data-reveal="0.2">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <div class="post-header__meta f-mono">
          <span>DATE: {post.data.date.toISOString().split('T')[0]}</span>
          <span class="meta-sep">·</span>
          <span>EST. READING: {post.data.readTime}</span>
        </div>

        <h1 class="post-title f-display" data-split="chars">
          {post.data.title}
        </h1>

        <div class="post-tags f-mono">
          {post.data.tags.map((tag) => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
      </header>

      <div class="post-body panel brackets" data-reveal="0.3">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <div class="markdown-render">
          <Content />
        </div>
      </div>

      <!-- Post End Navigation -->
      <div class="post-end panel" data-reveal="0.4">
        <div class="post-end__inner">
          <div>
            <span class="micro accent">END OF ARTICLE</span>
            <p class="f-mono text-muted">Wrote by SOOLOGNZz</p>
          </div>
          <a href={`${BASE}`} class="btn btn--primary" data-cursor="INDEX">
            <span class="btn__tab"></span>
            <span class="btn__fill"></span>
            <span class="btn__label">OTHER ARTICLES ↗</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <BlogFooter />
</BaseLayout>

<style>
  .post-article {
    flex: 1;
    max-width: 850px;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .post-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-back {
    margin-bottom: 0.5rem;
  }
  .post-header {
    padding: clamp(2rem, 5vw, 3.5rem);
    background: rgba(13, 13, 17, 0.7);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .post-header__meta {
    font-size: var(--fs-xs);
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .post-title {
    font-size: clamp(1.8rem, 3.8vw, 3.2rem);
    line-height: 1.1;
    color: var(--fg);
  }
  .post-tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tag-badge {
    font-size: 11px;
    color: var(--accent-hi);
    padding: 3px 8px;
    border: 1px solid var(--line-accent);
    background: rgba(193, 18, 31, 0.08);
  }

  .post-body {
    padding: clamp(2rem, 5vw, 3.5rem);
    background: rgba(13, 13, 17, 0.6);
    position: relative;
  }

  /* Two Column Layout */
  .post-two-column-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: calc(var(--hud-h) + 2rem) 2rem 5rem 2rem;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Table of Contents Sidebar */
  .post-toc-sidebar {
    position: fixed;
    top: 150px;
    left: 2rem;
    width: 280px;
    z-index: 100;
  }

  @media (max-width: 1300px) {
    .post-toc-sidebar {
      display: none;
    }
  }

  .toc-card {
    background: #111318;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  
  .toc-title-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.2rem;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.03);
    cursor: default;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .toc-icon {
    color: var(--accent);
  }

  .post-toc__list-wrapper {
    display: none; /* Hidden by default */
    padding: 0 1.2rem 1.2rem 1.2rem;
    max-height: 60vh;
    overflow-y: auto;
  }

  /* Hover to show */
  .toc-card:hover .post-toc__list-wrapper {
    display: block;
  }
  
  .toc-card:hover .toc-title-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .post-toc__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 0.9rem;
  }

  .post-toc__list li {
    margin-bottom: 0.75rem;
    position: relative;
  }
  
  .post-toc__list li:last-child {
    margin-bottom: 0;
  }

  .toc-level-1, .toc-level-2 { font-weight: 600; padding-left: 0; }
  .toc-level-3 { padding-left: 1rem; font-weight: 400; }
  .toc-level-4 { padding-left: 2rem; font-weight: 400; }

  .post-toc__list li::before {
    content: "•";
    position: absolute;
    left: -12px;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .toc-level-3::before, .toc-level-4::before {
    left: -2px;
  }

  .post-toc__list li:hover::before {
    opacity: 1;
  }

  .post-toc__list a {
    color: #9ca3af;
    text-decoration: none;
    display: block;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .post-toc__list a:hover {
    color: #3b82f6;
  }

  .post-end {
    padding: 2rem;
    background: rgba(22, 22, 28, 0.5);
  }
  .post-end__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
