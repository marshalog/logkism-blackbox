---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogNavbar from '../components/BlogNavbar.astro';
import BlogFooter from '../components/BlogFooter.astro';
import { POSTS } from '../data/posts';
import { BASE } from '../../site.config.mjs';
---

<BaseLayout
  title="chaotic blog by soolognz"
  description="Classified cybersecurity write-ups, aerospace telemetry analysis, and low-level reverse engineering logs."
>
  <BlogNavbar current="blog" />

  <main id="main-content">
    <!-- HERO HEADER -->
    <section class="blog-hero section wrap">
      <!-- Blurred hero background -->
      <div class="blog-hero__bg" aria-hidden="true" style={`background-image: url('${BASE}images/bg_blueprint.jpg'.replace('//', '/'));`}></div>
      
      <div class="blog-hero__avatar-wrap" data-reveal="0.1">
        <img src="https://github.com/marshalog.png" alt="Soolognz Avatar" class="blog-hero__avatar" />
      </div>

      <div class="blog-hero__badge" data-reveal="0.2">
        <span class="dot dot--red"></span>
        <span class="micro">PREPARE TO THE UNIVERSE</span>
      </div>

      <h1 class="sr-only">Chaotic Blog by Soolognz</h1>

      <p class="blog-hero__lead f-head" data-reveal="0.3">
        Mỗi bài viết là vết tích lưu lại những gì đã nghĩ, đọc, và làm... cũng có cái là huyền cảnh.
      </p>

      <!-- Category Filter Buttons -->
      <div class="filter-bar panel brackets" data-reveal="0.45" id="categories">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <button class="filter-chip is-active" data-filter="all" data-cursor="ALL">
          <span>// TOÀN BỘ</span>
          <small>({POSTS.length})</small>
        </button>
        <button class="filter-chip" data-filter="DRONE" data-cursor="DRONE">
          <span>DRONE</span>
        </button>
        <button class="filter-chip" data-filter="AEROSPACE" data-cursor="AERO">
          <span>KỸ THUẬT HÀNG KHÔNG</span>
        </button>
        <button class="filter-chip" data-filter="CTF-WRITEUP" data-cursor="CTF">
          <span>CTF-WRITEUPS</span>
        </button>
        <button class="filter-chip" data-filter="LAB-CHALLENGES" data-cursor="LAB">
          <span>LAB CHALLENGES</span>
        </button>
      </div>
    </section>

    <!-- POSTS TRANSMISSIONS LIST -->
    <section class="section wrap" id="feed" style="padding-top: 0;">
      <div class="sec-head">
        <span class="sec-head__idx">01 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">DECRYPTED TRANSMISSIONS</span>
        <span class="sec-head__tag t-xian cjk">Khắc Ấn Bí Tịch</span>
      </div>

      <div class="posts-stream">
        {POSTS.map((post, idx) => (
          <article
            class="post-log-item panel brackets"
            data-category={post.category}
            data-reveal={String(0.1 + idx * 0.1)}
          >
            <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
            <div class="post-log__top">
              <div class="post-log__meta f-mono">
                <span class="accent">LOG #{String(idx + 1).padStart(3, '0')}</span>
                <span class="meta-sep">//</span>
                <span>{post.date}</span>
                <span class="meta-sep">//</span>
                <span class="classification-badge classification--{post.classification.toLowerCase()}">{post.classification}</span>
              </div>
              <div class="post-log__readtime micro">{post.readTime}</div>
            </div>

            <h2 class="post-log__title f-display">
              <a href={`${BASE}posts/${post.slug}`} data-cursor="OPEN_LOG">
                {post.title}
              </a>
            </h2>

            <p class="post-log__summary f-mono">
              {post.summary}
            </p>

            <div class="post-log__tags f-mono">
              {post.tags.map((tag) => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>

            <div class="post-log__footer">
              <a
                href={`${BASE}posts/${post.slug}`}
                class="btn btn--sm btn--primary"
                data-cursor="DECRYPT"
              >
                <span class="btn__tab"></span>
                <span class="btn__fill"></span>
                <span class="btn__label t-cyber">DECRYPT ARTICLE →</span>
                <span class="btn__label t-xian cjk">Mở Mật Điển →</span>
              </a>
              <span class="micro text-muted">SECTOR: {post.category}</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <BlogFooter />
</BaseLayout>

<script>
  // Dynamic filter chips logic
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('.post-log-item');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');

      const filter = chip.dataset.filter;
      items.forEach((item) => {
        if (filter === 'all' || item.dataset.category === filter) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .blog-hero {
    position: relative;
    padding-top: calc(var(--hud-h) + 4rem);
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .blog-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    opacity: 0.7;
    /* Removed blur and mask to make the blueprint clearly visible */
  }
  .blog-hero__avatar-wrap {
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
  }
  .blog-hero__avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 2px solid var(--line-accent);
    padding: 6px;
    background: var(--bg);
    object-fit: cover;
    box-shadow: 0 0 20px var(--glow);
  }
  .blog-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.4rem 1rem;
    background: rgba(193, 18, 31, 0.12);
    border: 1px solid var(--line-accent);
    width: fit-content;
    margin-bottom: 1.8rem;
  }
  .blog-hero__title {
    font-size: var(--fs-hero);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin-bottom: 1.8rem;
  }
  .blog-hero__lead {
    max-width: 66ch;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 3rem;
  }

  /* FILTER BAR */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 1.2rem;
    background: rgba(13, 13, 17, 0.7);
    margin-bottom: 3.5rem;
  }
  .filter-chip {
    padding: 0.6rem 1.2rem;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--muted);
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .filter-chip:hover {
    color: var(--fg);
    border-color: var(--line-accent);
  }
  .filter-chip.is-active {
    background: var(--accent);
    color: var(--bone);
    border-color: var(--accent-hi);
  }

  /* POSTS LIST */
  .posts-stream {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-log-item {
    padding: 2.2rem;
    background: rgba(13, 13, 17, 0.65);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    transition: border-color 0.4s;
  }
  .post-log-item:hover {
    border-color: var(--line-accent);
  }
  .post-log__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .post-log__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--fs-xs);
  }
  .meta-sep {
    color: var(--dim);
  }
  .classification-badge {
    padding: 2px 6px;
    font-size: 9px;
    letter-spacing: 0.15em;
    font-weight: 600;
  }
  .classification--top-secret {
    background: rgba(193, 18, 31, 0.25);
    color: var(--accent-hi);
    border: 1px solid var(--accent-hi);
  }
  .classification--restricted {
    background: rgba(201, 162, 75, 0.2);
    color: var(--gold);
    border: 1px solid var(--gold);
  }
  .classification--unclassified {
    background: rgba(31, 122, 77, 0.2);
    color: var(--signal-hi);
    border: 1px solid var(--signal-hi);
  }
  .post-log__title {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    letter-spacing: 0.03em;
    color: var(--fg);
    transition: color 0.3s;
  }
  .post-log__title a:hover {
    color: var(--accent-hi);
  }
  .post-log__summary {
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.8;
  }
  .post-log__tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tag-pill {
    font-size: 10px;
    color: var(--accent-hi);
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
  }
  .post-log__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
