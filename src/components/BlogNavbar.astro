---
import { BASE, PORTFOLIO_URL } from '../../site.config.mjs';

interface Props {
  current?: string;
}

const { current = 'blog' } = Astro.props;
---

<header class="hud-nav" role="banner">
  <div class="hud-nav__inner wrap">
    <!-- Brand / Call sign -->
    <a href={`${BASE}`} class="hud-brand" data-cursor="BLACKBOX" aria-label="SOOLOGNZ Intelligence Log">
      <div class="hud-brand__mark">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width: 32px; height: 32px; color: var(--accent-hi);" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square" stroke-linejoin="miter">
          <!-- S: Left swept wing -->
          <path d="M 50,10 L 15,35 L 40,50 L 20,80" />
          <!-- K: Central fuselage and right wing -->
          <path d="M 50,10 L 50,90" />
          <path d="M 50,50 L 85,35" />
          <path d="M 50,50 L 80,80" />
          <!-- L: Tail base (mirrored for symmetry) -->
          <path d="M 30,90 L 70,90" />
          <circle cx="50" cy="50" r="4" fill="currentColor" />
        </svg>
        <span class="hud-brand__radar"></span>
      </div>
      <div class="hud-brand__info">
        <span class="hud-brand__name f-display">SOOLOGNZ</span>
        <span class="hud-brand__sub micro">PUBLIC LOGS</span>
      </div>
    </a>

    <!-- Navigation links -->
    <nav class="hud-links" aria-label="Blog Navigation">
      <a href={`${BASE}category/aerospace`} class="hud-link" data-cursor="AERO">
        <span class="hud-link__idx">//</span>
        <span>AEROSPACE</span>
      </a>
      <a href={`${BASE}category/cybersecurity`} class="hud-link" data-cursor="CYBER">
        <span class="hud-link__idx">//</span>
        <span>CYBERSECURITY</span>
      </a>
      <a href={PORTFOLIO_URL} class="hud-link" data-cursor="ABOUT">
        <span class="hud-link__idx">//</span>
        <span>ABOUT ME</span>
      </a>
    </nav>

    <!-- Right Controls: Mode Toggle, Warp to Mission Control (Portfolio) -->
    <div class="hud-ctrls">

      <!-- Mode Dropdown -->
      <div class="mode-dropdown" data-cursor="MODE_SELECT">
        <button type="button" class="mode-btn" aria-label="Select Mode">
          <div class="mode-btn__logo">
            <svg viewBox="0 0 44 44" class="mode-btn__base">
              <circle cx="22" cy="22" r="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
              <circle cx="22" cy="22" r="16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="6 4" class="mode-btn__ring"/>
            </svg>
            <div class="mode-btn__dynamic">
              <!-- Cyber Icon -->
              <svg viewBox="0 0 24 24" class="mode-btn__icon-cyber" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10" stroke-dasharray="4 4" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /><circle cx="12" cy="12" r="1" fill="currentColor" /></svg>
              <!-- Xianxia Icon -->
              <svg viewBox="0 0 24 24" class="mode-btn__icon-xian" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 0 0 20 5 5 0 0 1 0-10 5 5 0 0 0 0-10z" fill="currentColor"/><circle cx="12" cy="7" r="1.5" fill="currentColor"/><circle cx="12" cy="17" r="1.5" fill="var(--bg)"/></svg>
              <!-- Astronaut Icon (Rocket) -->
              <svg viewBox="0 0 24 24" class="mode-btn__icon-astro" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="2"/><line x1="7" y1="7" x2="17" y2="17"/><line x1="17" y1="7" x2="7" y2="17"/><circle cx="6" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="6" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/></svg>
            </div>
          </div>
        </button>
        <div class="mode-menu">
          <button type="button" class="mode-opt" data-mode-set="cyber">
            <svg viewBox="0 0 24 24" class="mode-opt__icon" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10" stroke-dasharray="4 4" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /><circle cx="12" cy="12" r="1" fill="currentColor" /></svg>
            <div class="mode-opt__text">
              <span class="mode-opt__id">01</span>
              <span class="mode-opt__label">CYBER_SEC</span>
            </div>
          </button>
          <button type="button" class="mode-opt" data-mode-set="xianxia">
            <svg viewBox="0 0 24 24" class="mode-opt__icon" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 0 0 20 5 5 0 0 1 0-10 5 5 0 0 0 0-10z" fill="currentColor"/><circle cx="12" cy="7" r="1.5" fill="currentColor"/><circle cx="12" cy="17" r="1.5" fill="var(--bg)"/></svg>
            <div class="mode-opt__text">
              <span class="mode-opt__id">02</span>
              <span class="mode-opt__label">XIANXIA_DAO</span>
            </div>
          </button>
          <button type="button" class="mode-opt" data-mode-set="astronaut">
            <svg viewBox="0 0 24 24" class="mode-opt__icon" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="2"/><line x1="7" y1="7" x2="17" y2="17"/><line x1="17" y1="7" x2="7" y2="17"/><circle cx="6" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="6" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/></svg>
            <div class="mode-opt__text">
              <span class="mode-opt__id">03</span>
              <span class="mode-opt__label">ASTRO_EXPLORE</span>
            </div>
          </button>
        </div>
      </div>


    </div>
  </div>
</header>

<style>
  .hud-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--hud-h);
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    background: rgba(7, 7, 10, 0.7);
  }
  [data-mode='xianxia'] .hud-nav {
    background: rgba(10, 7, 6, 0.75);
    border-bottom-color: var(--line);
  }
  .hud-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }
  .hud-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hud-brand__mark {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .hud-brand__sigil {
    font-family: var(--f-display);
    font-size: 13px;
    color: var(--accent-hi);
    letter-spacing: 0.05em;
  }
  .hud-brand__radar {
    position: absolute;
    inset: -3px;
    border: 1px dashed var(--line-2);
    border-radius: 50%;
    animation: spin 16s linear infinite;
  }
  .hud-brand__name {
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    color: var(--fg);
    display: block;
  }
  .hud-brand__sub {
    display: block;
    font-size: 8px;
    color: var(--muted);
  }
  .hud-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  @media (max-width: 990px) {
    .hud-links {
      display: none;
    }
  }
  .hud-link {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.15em;
    color: var(--muted);
    position: relative;
    padding: 0.4rem 0;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hud-link__idx {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-hi);
  }
  .hud-link:hover,
  .hud-link.is-active {
    color: var(--fg);
  }
  .hud-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-hi);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .hud-link:hover::after,
  .hud-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .hud-ctrls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .hud-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    background: rgba(22, 22, 28, 0.4);
  }
  @media (max-width: 600px) {
    .hud-status {
      display: none;
    }
  }
  .hud-status__clock {
    font-size: 10px;
    color: var(--muted);
  }
  
  /* Dropdown Styles */
  .mode-dropdown {
    position: relative;
  }
  .mode-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--fg);
    cursor: pointer;
    border-radius: 50%;
    transition: color 0.3s;
  }
  .mode-btn:hover {
    color: var(--accent-hi);
  }
  .mode-btn__logo {
    position: relative;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-hi);
  }
  .mode-btn__base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mode-btn__ring {
    transform-origin: 50% 50%;
    animation: hud-spin 12s linear infinite;
  }
  .mode-btn:hover .mode-btn__ring {
    animation-duration: 3s;
  }
  .mode-btn__dynamic {
    position: relative;
    z-index: 1;
    width: 14px;
    height: 14px;
  }
  .mode-btn__icon-cyber, .mode-btn__icon-xian, .mode-btn__icon-astro {
    width: 100%;
    height: 100%;
    display: none;
  }
  :global([data-mode="cyber"]) .mode-btn__icon-cyber { display: block; }
  :global([data-mode="xianxia"]) .mode-btn__icon-xian { display: block; }
  :global([data-mode="astronaut"]) .mode-btn__icon-astro { display: block; }

  @keyframes hud-spin {
    to { transform: rotate(360deg); }
  }
  .mode-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: max-content;
    background: rgba(13, 13, 17, 0.95);
    border: 1px solid var(--line);
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mode-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .mode-opt {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.2rem 0.6rem 0.8rem;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-2);
    color: var(--muted);
    font-family: var(--f-mono);
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
  }
  .mode-opt:last-child {
    border-bottom: none;
  }
  .mode-opt:hover {
    background: rgba(193, 18, 31, 0.1);
    color: var(--fg);
  }
  :global([data-mode="xianxia"]) .mode-opt:hover { background: rgba(212, 175, 55, 0.1); }
  :global([data-mode="astronaut"]) .mode-opt:hover { background: rgba(0, 255, 255, 0.1); }
  
  .mode-opt__icon {
    width: 16px;
    height: 16px;
    opacity: 0.5;
    transition: all 0.3s;
  }
  .mode-opt:hover .mode-opt__icon {
    opacity: 1;
    color: var(--accent-hi);
    transform: scale(1.1);
  }
  .mode-opt__text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .mode-opt__id {
    font-size: 9px;
    color: var(--accent-hi);
  }
  .mode-opt__label {
    font-size: 11px;
    letter-spacing: 0.05em;
  }
</style>
