---
import { BASE, PORTFOLIO_URL } from '../../site.config.mjs';
---

<footer class="hud-footer" role="contentinfo">
  <div class="wrap hud-footer__inner">
    <div class="hud-footer__col">
      <div class="hud-footer__logo f-display">SOOLOGNZ</div>
    </div>



    <div class="hud-footer__col">
      <div class="micro footer-tag">PORTFOLIO</div>
      <p class="footer-note f-mono">
        Portfolio của blogger này
      </p>
      <a href={PORTFOLIO_URL} class="btn btn--sm btn--primary" data-cursor="WARP">
        <span class="btn__tab"></span>
        <span class="btn__fill"></span>
        <span class="btn__label">VIEW PORTFOLIO ↗</span>
      </a>
    </div>
  </div>

  <div class="hud-footer__bar wrap">
    <span class="micro">© {new Date().getFullYear()} SOOLOGNZ BY LOGKISM.</span>
  </div>
</footer>

<style>
  .hud-footer {
    position: relative;
    border-top: 1px solid var(--line-accent);
    background: linear-gradient(180deg, rgba(7, 7, 10, 0.4), rgba(7, 7, 10, 0.95));
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    z-index: 10;
  }
  .hud-footer__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: 2.5rem;
  }
  @media (max-width: 860px) {
    .hud-footer__inner {
      grid-template-columns: 1fr;
    }
  }
  .hud-footer__logo {
    font-size: 1.8rem;
    letter-spacing: 0.15em;
    color: var(--accent-hi);
    margin-bottom: 1rem;
  }
  .hud-footer__desc {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: var(--fs-xs);
  }
  .hud-footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.8rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .footer-tag {
    color: var(--accent-hi);
    margin-bottom: 1.2rem;
    display: block;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: var(--fs-xs);
  }
  .footer-note {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .hud-footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
