---
import { BASE, PORTFOLIO_URL } from '../../site.config.mjs';
---

<footer class="hud-footer" role="contentinfo">
  <div class="wrap hud-footer__inner">
    <div class="hud-footer__col">
      <div class="hud-footer__logo f-display">BLACKBOX</div>
      <p class="hud-footer__desc f-mono">
        CLASSIFIED CYBERSECURITY RECON & AEROSPACE WRITE-UPS<br />
        Phân tích chuyên sâu · Zero-Day Exploit · Giao thức truyền tin vũ trụ
      </p>
      <div class="hud-footer__badge">
        <span class="dot dot--red"></span>
        <span class="micro">DECLASSIFIED INTEL // PUBLIC ACCESS GRANTED</span>
      </div>
    </div>

    <div class="hud-footer__col">
      <div class="micro footer-tag">INDEX & TOPICS</div>
      <ul class="footer-links f-mono">
        <li><a href={`${BASE}`} class="link-slash" data-cursor="FILTER">01 // Vệ tinh & Sóng vô tuyến RF</a></li>
        <li><a href={`${BASE}`} class="link-slash" data-cursor="FILTER">02 // Reverse Engineering Firmware bay</a></li>
        <li><a href={`${BASE}`} class="link-slash" data-cursor="FILTER">03 // CTF Write-ups & Kernel Exploitation</a></li>
        <li><a href={`${BASE}`} class="link-slash" data-cursor="FILTER">04 // Vi mã hoá lượng tử vi điều khiển</a></li>
      </ul>
    </div>

    <div class="hud-footer__col">
      <div class="micro footer-tag">PORTAL TO MISSION CONTROL</div>
      <p class="footer-note f-mono">
        Trở về trang Portfolio chính <b>LOGKISM // MISSION CONTROL</b> để xem toàn bộ hồ sơ kinh nghiệm, kho vũ khí công nghệ và thông tin liên hệ.
      </p>
      <a href={PORTFOLIO_URL} class="btn btn--sm btn--primary" data-warp="MISSION CONTROL" data-cursor="WARP">
        <span class="btn__tab"></span>
        <span class="btn__fill"></span>
        <span class="btn__label">WARP TO MISSION CONTROL ↖</span>
      </a>
    </div>
  </div>

  <div class="hud-footer__bar wrap">
    <span class="micro">© {new Date().getFullYear()} BLACKBOX BY LOGKISM. CLASSIFIED RESEARCH LOG.</span>
    <span class="micro">DATA STREAM: SECURE // NO AI SLOP ALLOWED</span>
  </div>
</footer>

<style>
  .hud-footer {
    position: relative;
    border-top: 1px solid var(--line-accent);
    background: linear-gradient(180deg, rgba(7, 7, 10, 0.4), rgba(7, 7, 10, 0.95));
    padding-top: clamp(4rem, 8vh, 6rem);
    padding-bottom: 2rem;
    z-index: 10;
  }
  .hud-footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: 4rem;
  }
  @media (max-width: 860px) {
    .hud-footer__inner {
      grid-template-columns: 1fr;
    }
  }
  .hud-footer__logo {
    font-size: 1.8rem;
    letter-spacing: 0.15em;
    color: var(--accent-hi);
    margin-bottom: 1rem;
  }
  .hud-footer__desc {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: var(--fs-xs);
  }
  .hud-footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.8rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .footer-tag {
    color: var(--accent-hi);
    margin-bottom: 1.2rem;
    display: block;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: var(--fs-xs);
  }
  .footer-note {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .hud-footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
