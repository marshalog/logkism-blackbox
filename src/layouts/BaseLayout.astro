---
interface Props {
  title: string;
  description?: string;
  siteName?: string;
  image?: string;
}

const {
  title,
  description = "BLACKBOX // Classified CyberSec Write-ups & Aerospace Telemetry Research Articles.",
  siteName = "LOGKISM // BLACKBOX",
  image = "images/bg_cyber.jpg"
} = Astro.props;

import { BASE, PORTFOLIO_URL } from '../../site.config.mjs';
---

<!doctype html>
<html lang="vi" data-mode="cyber" class="is-arriving">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070a" />

    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Ma+Shan+Zheng&family=Martian+Mono:wght@400;600&family=Michroma&family=Saira:ital,wght@0,300;0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href={`${BASE}/styles/tokens.css`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/base.css`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/buttons.css`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/fx.css`.replace('//', '/')} />

    <script is:inline>
      try {
        const m = localStorage.getItem('lk-mode');
        if (m === 'xianxia') document.documentElement.dataset.mode = 'xianxia';
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-site="blackbox" data-portfolio-url={PORTFOLIO_URL}>
    <!-- Background Canvas and Artwork Stack -->
    <div class="bg-stack" aria-hidden="true">
      <canvas id="nebula-canvas"></canvas>
      <div class="bg-art bg-art--cyber" style={`background-image: url('${BASE}/images/bg_cyber.jpg'.replace('//', '/'));`}></div>
      <div class="bg-art bg-art--xian" style={`background-image: url('${BASE}/images/bg_xianxia.jpg'.replace('//', '/'));`}></div>
      <div class="bg-art bg-art--astro" style={`background-image: url('${BASE}/images/bg_astro.jpg'.replace('//', '/')); filter: grayscale(1) brightness(0.4) contrast(1.8);`}></div>
      
      <!-- Aerospace Mode Fleet (Jets, Drone) - Background Layer -->
      <div class="astro-fleet">
        <div class="astro-fleet__unit astro-fleet__unit--f22">
          <svg viewBox="0 0 100 100" fill="currentColor"><path d="M 50 10 L 55 30 L 90 60 L 90 70 L 55 65 L 55 85 L 70 100 L 30 100 L 45 85 L 45 65 L 10 70 L 10 60 L 45 30 Z"/></svg>
        </div>
        <div class="astro-fleet__unit astro-fleet__unit--su57">
          <svg viewBox="0 0 100 100" fill="currentColor"><path d="M 50 5 L 60 35 L 95 65 L 95 75 L 60 70 L 60 90 L 75 105 L 25 105 L 40 90 L 40 70 L 5 75 L 5 65 L 40 35 Z"/></svg>
        </div>
        <div class="astro-fleet__unit astro-fleet__unit--drone">
          <svg viewBox="0 0 100 100" fill="currentColor" stroke="currentColor" stroke-width="2">
            <circle cx="50" cy="50" r="10" />
            <line x1="20" y1="20" x2="80" y2="80" />
            <line x1="80" y1="20" x2="20" y2="80" />
            <circle cx="20" cy="20" r="12" fill="none" stroke-dasharray="4 4" />
            <circle cx="80" cy="80" r="12" fill="none" stroke-dasharray="4 4" />
            <circle cx="80" cy="20" r="12" fill="none" stroke-dasharray="4 4" />
            <circle cx="20" cy="80" r="12" fill="none" stroke-dasharray="4 4" />
          </svg>
        </div>
      </div>

      <canvas id="particle-canvas"></canvas>
      <div class="bg-scan"></div>
      <div class="bg-grain"></div>
      <div class="bg-vignette"></div>
    </div>

    <!-- HUD Frame Corners -->
    <div class="hud-frame" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>

    <!-- Altitude scroll rail -->
    <div class="alt-rail" aria-hidden="true">
      <div class="alt-rail__ticks">
        <div class="alt-rail__fill"></div>
      </div>
      <div class="alt-rail__val">ALT 000</div>
    </div>

    <!-- Cursor -->
    <div class="cursor" aria-hidden="true">
      <div class="cursor__dot"></div>
      <div class="cursor__ring">
        <!-- Cyber Icon -->
        <svg viewBox="0 0 24 24" class="cursor__icon-cyber" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 2 17 12 22 22 17 22 7 12 2" /><circle cx="12" cy="12" r="4" stroke-dasharray="2 2" /></svg>
        <!-- Xianxia Icon -->
        <svg viewBox="0 0 24 24" class="cursor__icon-xian" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 0 0 20 5 5 0 0 1 0-10 5 5 0 0 0 0-10z" fill="currentColor"/><circle cx="12" cy="7" r="1.5" fill="currentColor"/><circle cx="12" cy="17" r="1.5" fill="var(--bg)"/></svg>
        <!-- Astronaut Icon (Rocket) -->
        <svg viewBox="0 0 24 24" class="cursor__icon-astro" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2 C14 6 15 13 15 18 L18 22 L6 22 L9 18 C9 13 10 6 12 2 Z" stroke-linejoin="round" /><path d="M10 22 L10 25 M12 22 L12 26 M14 22 L14 25" stroke-dasharray="2 2" /></svg>
      </div>
      <div class="cursor__meta">
        <span class="cursor__label">READ</span><br />
        <span class="cursor__coords">X 0000 · Y 0000</span>
      </div>
    </div>

    <!-- Curtain -->
    <div class="curtain" aria-hidden="true">
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__hud">
        <span class="micro">DECRYPTING INTEL LOG</span>
        <div class="curtain__target">INITIALIZING</div>
        <div class="curtain__line"><i></i></div>
      </div>
    </div>

    <!-- Warp Jump -->
    <div class="warp" aria-hidden="true">
      <canvas id="warp-canvas"></canvas>
      <div class="warp__panel">
        <div class="warp__title">UPLINK DRIVE</div>
        <div class="warp__log"></div>
      </div>
    </div>

    <slot />

    <script>
      import { initNebula, initParticles, initArtParallax } from '../scripts/core/background';
      import { initCursor, initClickFx, initMagnetic, initScramble } from '../scripts/core/interact';
      import { initModeToggle } from '../scripts/core/mode';
      import { initSmooth, initHud, initReveals } from '../scripts/core/motion';
      import { initTransitions, arrive } from '../scripts/core/transition';

      document.addEventListener('DOMContentLoaded', () => {
        initNebula(document.getElementById('nebula-canvas') as HTMLCanvasElement);
        initParticles(document.getElementById('particle-canvas') as HTMLCanvasElement);
        initArtParallax();
        initCursor();
        initClickFx();
        initMagnetic();
        initScramble();
        initModeToggle();
        initSmooth();
        initHud();
        initReveals();
        initTransitions();
        arrive();
      });
    </script>
  </body>
</html>
