---
interface Props {
  title: string;
  description?: string;
  siteName?: string;
  image?: string;
}

const {
  title,
  description = "Classified CyberSec Write-ups & Aerospace Telemetry Research Articles.",
  siteName = "LOGKISM",
  image = "images/bg_cyber.jpg"
} = Astro.props;

import { BASE, PORTFOLIO_URL } from '../../site.config.mjs';
---

<!doctype html>
<html lang="en" data-mode="cyber" class="is-arriving">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title.toLowerCase().includes('chaotic') ? 'Chaotic Blog by soolognz' : `${title} — Chaotic Blog by soolognz`}</title>
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070a" />

    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Ma+Shan+Zheng&family=Martian+Mono:wght@400;600&family=Michroma&family=Saira:ital,wght@0,300;0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href={`${BASE}/styles/tokens.css?v=5`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/base.css?v=5`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/buttons.css?v=5`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/fx.css?v=5`.replace('//', '/')} />
    <link rel="stylesheet" href={`${BASE}/styles/markdown.css?v=2`.replace('//', '/')} />

    <script is:inline>
      try {
        const m = localStorage.getItem('lk-mode');
        if (m === 'xianxia') document.documentElement.dataset.mode = 'xianxia';
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-site="blackbox" data-portfolio-url={PORTFOLIO_URL}>
    <!-- Background Artwork Stack -->
    <div class="bg-stack" aria-hidden="true">
      <div class="bg-art bg-art--cyber" style={`background-image: url('${BASE}images/bg_cyber.jpg');`}></div>
      <div class="bg-art bg-art--xian" style={`background-image: url('${BASE}images/bg_xianxia.jpg');`}></div>
      <div class="bg-art bg-art--astro" style={`background-image: url('${BASE}images/bg_blueprint.jpg'); opacity: 0.15; filter: blur(4px);`}></div>
      


      <div class="bg-scan"></div>
      <div class="bg-grain"></div>
      <div class="bg-vignette"></div>
    </div>

    <!-- HUD Frame Corners -->
    <div class="hud-frame" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>

    <!-- Altitude scroll rail -->
    <div class="alt-rail" aria-hidden="true">
      <div class="alt-rail__ticks">
        <div class="alt-rail__fill"></div>
      </div>
      <div class="alt-rail__val">ALT 000</div>
    </div>

    <!-- Cursor -->
    <div class="cursor" aria-hidden="true">
      <div class="cursor__dot"></div>
      <div class="cursor__ring">
        <!-- Cyber Icon (Paper Airplane) -->
        <svg viewBox="0 0 24 24" class="cursor__icon-cyber" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13" />
          <path d="M22 2L15 22L11 13L2 9L22 2Z" />
        </svg>
        <!-- Xianxia Icon -->
        <svg viewBox="0 0 24 24" class="cursor__icon-xian" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 0 0 20 5 5 0 0 1 0-10 5 5 0 0 0 0-10z" fill="currentColor"/><circle cx="12" cy="7" r="1.5" fill="currentColor"/><circle cx="12" cy="17" r="1.5" fill="var(--bg)"/></svg>
        <!-- Astronaut Icon (Rocket) -->
        <svg viewBox="0 0 24 24" class="cursor__icon-astro" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="2"/><line x1="7" y1="7" x2="17" y2="17"/><line x1="17" y1="7" x2="7" y2="17"/><circle cx="6" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="18" cy="6" r="2.5" stroke-dasharray="1.5 1.5"/><circle cx="6" cy="18" r="2.5" stroke-dasharray="1.5 1.5"/></svg>
      </div>
      <div class="cursor__meta">
        <span class="cursor__label">READ</span><br />
        <span class="cursor__coords">X 0000 · Y 0000</span>
      </div>
    </div>

    <!-- Curtain -->
    <div class="curtain" aria-hidden="true">
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__bar"></div>
      <div class="curtain__hud">
        <span class="micro">DECRYPTING INTEL LOG</span>
        <div class="curtain__target">INITIALIZING</div>
        <div class="curtain__line"><i></i></div>
      </div>
    </div>

    <!-- Warp Jump -->
    <div class="warp" aria-hidden="true">
      <canvas id="warp-canvas"></canvas>
      <div class="warp__panel">
        <div class="warp__title">UPLINK DRIVE</div>
        <div class="warp__log"></div>
      </div>
    </div>

    <slot />

    <script>
      import { initNebula, initParticles, initArtParallax } from '../scripts/core/background';
      import { initCursor, initClickFx, initMagnetic, initScramble } from '../scripts/core/interact';
      import { initModeToggle } from '../scripts/core/mode';
      import { initSmooth, initHud, initReveals } from '../scripts/core/motion';
      import { initTransitions, arrive } from '../scripts/core/transition';

      document.addEventListener('DOMContentLoaded', () => {
        initArtParallax();
        initCursor();
        initClickFx();
        initMagnetic();
        initScramble();
        initModeToggle();
        initSmooth();
        initHud();
        initReveals();
        initTransitions();
        arrive();
      });
    </script>
  </body>
</html>
